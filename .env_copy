# !!! This is a sample COPY of the .env file. Do not use in production !!!

# ----- Logging -----
LOG_LEVEL=DEBUG
LOG_PATH=logs/gcs.log

# ----- Serial Connection -----
BAUDRATE=115200

# ----- SITL / TCP Connection -----
TCP_HOST=127.0.0.1
TCP_PORT=5760

# Firebase Admin SDK
FIREBASE_CREDENTIALS_JSON_PATH=config/firebase_key.json

FIREBASE_DB_URL=your_url_here

FIREBASE_DB_PATH=your_path_here

# ----- Sistem Bilgileri / Hava Durumu -----
WEATHER_ENABLED=true
WEATHER_TIMEOUT_SEC=3

# Güvenlik tercihleri
USE_DEVICE_LOCATION=true
USE_IP_LOCATION=false

#DEFAULT_CITY=X
#DEFAULT_LAT=X
#DEFAULT_LON=X


